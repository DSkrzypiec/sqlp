{"sql":"with testdata(bits) as (values\n  -- small subnormals\n  (x'0000000000000001'),\n  (x'0000000000000002'), (x'0000000000000003'),\n  (x'0000000000001000'), (x'0000000100000000'),\n  (x'0000010000000000'), (x'0000010100000000'),\n  (x'0000400000000000'), (x'0000400100000000'),\n  (x'0000800000000000'), (x'0000800000000001'),\n  -- these values taken from upstream testsuite\n  (x'00000000000f4240'),\n  (x'00000000016e3600'),\n  (x'0000008cdcdea440'),\n  -- borderline between subnormal and normal\n  (x'000ffffffffffff0'), (x'000ffffffffffff1'),\n  (x'000ffffffffffffe'), (x'000fffffffffffff'))\nselect float8send(flt) as ibits,\n       flt\n  from (select bits::bigint::xfloat8::float8 as flt\n          from testdata\n\toffset 0) s","shape":"WITH testdata(bits) AS (VALUES (X'0000000000000001'), (X'0000000000000002'), (X'0000000000000003'), (X'0000000000001000'), (X'0000000100000000'), (X'0000010000000000'), (X'0000010100000000'), (X'0000400000000000'), (X'0000400100000000'), (X'0000800000000000'), (X'0000800000000001'), (X'00000000000f4240'), (X'00000000016e3600'), (X'0000008cdcdea440'), (X'000ffffffffffff0'), (X'000ffffffffffff1'), (X'000ffffffffffffe'), (X'000fffffffffffff')) SELECT float8send(flt) AS ibits, flt FROM (SELECT bits::bigint::xfloat8::float8 AS flt FROM testdata OFFSET 0) AS s;"}
