{"sql":"SELECT x, y,\n       atan2d(y, x),\n       atan2d(y, x) IN (-90,0,90,180) AS atan2d_exact\nFROM (SELECT 10*cosd(a), 10*sind(a)\n      FROM generate_series(0, 360, 90) AS t(a)) AS t(x,y)","shape":"SELECT x, y, atan2d(y, x), atan2d(y, x) IN (-90, 0, 90, 180) AS atan2d_exact FROM (SELECT 10 * cosd(a), 10 * sind(a) FROM generate_series(0, 360, 90) AS t(a)) AS t(x, y);"}
