{"sql":"SELECT md5sum(ed||'/'||sx||'/'||sy||',') FROM (\n      SELECT editdist3(a.x,b.x) AS ed, a.x AS sx, b.x AS sy\n        FROM words a, words b\n       WHERE a.x<b.x\n       ORDER BY 1, 2\n  )"}
